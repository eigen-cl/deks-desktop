{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DEKS Desktop",
  "version": "0.2.1",
  "identifier": "cl.eigen.deks.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DEKS Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 620
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "EIGEN",
    "copyright": "Copyright © 2026 EIGEN",
    "category": "Productivity",
    "shortDescription": "Local-first editor for the open DEKS presentation format.",
    "longDescription": "Create and edit portable DEKS presentations locally, with optional agent workflows through MCP.",
    "resources": {
      "../LICENSE": "bundled-mcp/LICENSE",
      "../bundled-mcp/": "bundled-mcp/",
      "../bundled-skills/": "bundled-skills/",
      "../mcp/": "bundled-mcp/mcp/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
